{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build all labs",
            "type": "shell",
            "command": "./run.sh --build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run all labs",
            "type": "shell",
            "command": "./run.sh",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run current file",
            "type": "shell",
            "command": "./run.sh \"${fileBasenameNoExtension}\"",
            "problemMatcher": ["$gcc"]
        }
    ]
}
